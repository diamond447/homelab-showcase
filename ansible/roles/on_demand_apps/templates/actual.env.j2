# Managed by Ansible. Actual Budget (fork) sign-in through Authentik OIDC.
# Edge forward auth still guards the hostname; OIDC gives each person their
# own Actual user, created on first login.
ACTUAL_LOGIN_METHOD=openid
# Password login is refused for every request. Enforce stays off on purpose:
# with it on, Actual hides the password method and skips the server password
# check on the first OIDC sign-in, so anyone in `users` could claim ownership.
ACTUAL_ALLOWED_LOGIN_METHODS=openid
ACTUAL_OPENID_ENFORCE=false
ACTUAL_USER_CREATION_MODE=login
ACTUAL_OPENID_PROVIDER_NAME=Authentik
ACTUAL_OPENID_DISCOVERY_URL=https://{{ authentik_domain }}/application/o/actual-budget/.well-known/openid-configuration
ACTUAL_OPENID_SERVER_HOSTNAME=https://{{ actual_domain }}
ACTUAL_OPENID_CLIENT_ID={{ actual_oidc_client_id }}
ACTUAL_OPENID_CLIENT_SECRET={{ vault_actual_oidc_client_secret }}
