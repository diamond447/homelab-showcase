name: on-demand-infra

services:
  socket-proxy:
    image: {{ socket_proxy_image }}
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /run
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    environment:
      CONTAINERS: "1"
      EVENTS: "1"
      VERSION: "1"
      POST: "1"
      AUTH: "0"
      SECRETS: "0"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - docker-api
    cpus: 0.25
    mem_limit: 128m
    pids_limit: 64
    logging: &local-logging
      driver: local
      options:
        max-size: 10m
        max-file: "3"
    healthcheck:
      # Restarting docker.socket (e.g. a Docker upgrade) recreates docker.sock
      # while live-restore keeps this container running on the old
      # bind-mounted inode, so it answers 503 forever. Exiting lets the
      # restart policy remount the new socket.
      test: ["CMD-SHELL", "wget -q -T 3 -O /dev/null http://127.0.0.1:2375/version || kill 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 5s

  sablier:
    image: {{ sablier_image }}
    restart: unless-stopped
    command:
      - start
      - --provider.name=docker
      - --provider.reject-unlabeled-requests=true
      - --provider.auto-stop-on-startup=true
      - --provider.auto-stop-externally-started=true
      - --provider.docker.strategy=stop
      - --sessions.default-duration=15m
      - --sessions.expiration-interval=30s
    environment:
      DOCKER_HOST: tcp://socket-proxy:2375
    depends_on:
      socket-proxy:
        condition: service_healthy
    networks:
      - docker-api
      - sablier-api
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    cpus: 0.5
    mem_limit: 256m
    pids_limit: 64
    logging: *local-logging

  wasm-proxy:
    image: homelab/nginx-wasm:0.6.0-v1.1.0
    restart: unless-stopped
    ports:
      - "{{ apps01_host }}:{{ apps01_wasm_port }}:8080"
    volumes:
      - /opt/apps/on-demand/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    networks:
      - apps-net
      - sablier-api
      # Reaches homepage-api for the admin dashboard's /_homelab/agent/.
      - homepage-api
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cpus: 1.0
    mem_limit: 512m
    pids_limit: 128
    logging: *local-logging
    depends_on:
      sablier:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "kill -0 1 && bash -c 'exec 3<>/dev/tcp/sablier/10000'"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 10s

networks:
  apps-net:
    external: true
  homepage-api:
    external: true
  docker-api:
    external: true
  sablier-api:
    name: sablier-api
    internal: true
