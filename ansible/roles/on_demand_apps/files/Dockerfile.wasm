ARG UBUNTU_IMAGE=ubuntu:22.04@sha256:281c5745f657873d78e5531fc5ba8575f46ab7769b94550ac99543f122679986
FROM ${UBUNTU_IMAGE}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libatomic1=12.3.0-1ubuntu1~22.04.3 \
    && rm -rf /var/lib/apt/lists/*

COPY nginx /usr/sbin/nginx
COPY sablier-proxywasm-plugin.wasm /wasm/sablier-proxywasm-plugin.wasm
COPY nginx.conf /etc/nginx/nginx.conf

USER 65534:65534
EXPOSE 8080
ENTRYPOINT ["/usr/sbin/nginx"]
CMD ["-p", "/tmp/", "-c", "/etc/nginx/nginx.conf", "-g", "daemon off;"]
