# Managed by Ansible (role fit). Internet-facing Fit MCP server: only its own token key
# and the openGym API; no access to the health database.
FIT_OPENGYM_URL=http://web:8080
FIT_OPENGYM_VERSION={{ fit_opengym_version }}
FIT_DB_PATH=/data/fit.db
FIT_TOKEN_KEY={{ vault_fit_token_key }}
FIT_TIMEZONE={{ timezone }}
FIT_MCP_HOST=0.0.0.0
FIT_MCP_PORT=8081
FIT_MCP_ALLOWED_HOSTS=["{{ fit_domain }}","{{ health_coach_host }}:{{ fit_mcp_port }}"]
FIT_PUBLIC_URL=https://{{ fit_domain }}/mcp
FIT_AUTH_ISSUER=https://{{ authentik_domain }}/application/o/fit/
FIT_AUTH_AUDIENCE=["{{ fit_oidc_client_id }}"]
FIT_AUTH_JWKS_URL=http://{{ authentik_host }}:{{ authentik_port }}/application/o/fit/jwks/
