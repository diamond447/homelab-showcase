# Managed by Ansible (role fit). openGym API settings (see openGym's .env.example).
# Passkeys are bound to this host name.
RP_ID={{ fit_domain }}
ORIGIN=https://{{ fit_domain }}
RP_NAME=openGym
# The first profile becomes admin. It must be registered with invite-only off (nobody could
# create the first code otherwise); friends and family then need an invite code from the
# admin dashboard.
FIRST_USER_ADMIN=1
INVITE_ONLY={{ '1' if fit_opengym_invite_only | bool else '0' }}
ALLOW_GUEST=0
# Password sign-in next to passkeys, for browsers without passkey support.
PASSWORD_LOGIN=1
{% if fit_opengym_admin_uids %}
ADMIN_UIDS={{ fit_opengym_admin_uids | join(',') }}
{% endif %}
