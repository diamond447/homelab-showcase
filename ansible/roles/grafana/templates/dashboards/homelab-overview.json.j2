{
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Nodes online",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(up{job=\"node\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Proxmox CPU",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "100 - avg(rate(node_cpu_seconds_total{job=\"node\",host=\"pve01\",mode=\"idle\"}[5m])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "stat",
      "title": "Proxmox RAM",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{host=\"pve01\"} / node_memory_MemTotal_bytes{host=\"pve01\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "stat",
      "title": "Proxmox disk",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{host=\"pve01\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{host=\"pve01\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "bargauge",
      "title": "CPU by node",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])) * 100",
          "legendFormat": "{{ '{{ host }}' }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "bargauge",
      "title": "RAM by node",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "{{ '{{ host }}' }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU history",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])) * 100",
          "legendFormat": "{{ '{{ host }}' }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "stat",
      "title": "Proxmox status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "max(pve_up{id=~\"node/.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN" },
                "1": { "text": "UP" }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "LXC running",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 21 },
      "targets": [
        {
          "expr": "sum(pve_up{id=~\"lxc/.*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "LXC total",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "count(pve_up{id=~\"lxc/.*\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "PVE uptime",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 21 },
      "targets": [
        {
          "expr": "max(pve_uptime_seconds{id=~\"node/.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "LXC CPU",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "100 * (pve_cpu_usage_ratio{id=~\"lxc/.*\"} * on(id) group_left(name) pve_guest_info{type=\"lxc\"})",
          "legendFormat": "{{ '{{ name }}' }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "LXC RAM",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "expr": "100 * ((pve_memory_usage_bytes{id=~\"lxc/.*\"} / pve_memory_size_bytes{id=~\"lxc/.*\"}) * on(id) group_left(name) pve_guest_info{type=\"lxc\"})",
          "legendFormat": "{{ '{{ name }}' }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Proxmox storage",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "targets": [
        {
          "expr": "100 * ((pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"}) * on(id) group_left(storage) pve_storage_info)",
          "legendFormat": "{{ '{{ storage }}' }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["homelab", "ansible"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Homelab Overview",
  "uid": "homelab-overview",
  "version": 1
}
