route:
  group_by: ['alertname', 'host']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  receiver: ntfy

receivers:
  - name: ntfy
    webhook_configs:
      - url: "{{ ntfy_server }}/{{ vault_ntfy_topic }}?template=alertmanager"
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: "{{ vault_ntfy_alerts_token }}"
