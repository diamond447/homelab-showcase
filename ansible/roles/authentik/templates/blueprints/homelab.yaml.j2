# Managed by Ansible. Do not edit on auth01.
# Secrets are provided to authentik through environment variables.
version: 1

metadata:
  name: Homelab
  labels:
    blueprints.goauthentik.io/instantiate: "true"

entries:
  # Access-control groups. Membership is intentionally NOT managed here.
  # Group `homelab admins` inherits membership from `users`.
  - model: authentik_core.group
    state: present
    identifiers:
      name: users
    attrs:
      is_superuser: false

  - model: authentik_core.group
    state: present
    identifiers:
      name: homelab admins
    attrs:
      is_superuser: false
      parents:
        - !Find [authentik_core.group, [name, users]]

{% if health_coach_oidc_client_id %}
  # Group `health coach` for users allowed to use the Claude Health Coach connector.
  # Membership is intentionally NOT managed here.
  - model: authentik_core.group
    state: present
    identifiers:
      name: health coach
    attrs:
      is_superuser: false

{% endif %}
  # Default access for every application: bind group `users` to default provider
  # authorization flows so that unassigned users cannot access any application.
  # The target must be looked up as the policy binding model: a Flow's own primary
  # key differs from the pbm_uuid the binding stores, so a Flow lookup never
  # matches the existing binding and every apply would add another one.
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_policies.policybindingmodel, [flow__slug, default-provider-authorization-implicit-consent]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, users]]

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_policies.policybindingmodel, [flow__slug, default-provider-authorization-explicit-consent]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, users]]

  # Actual Budget OIDC provider. Edge forward auth (homelab-domain) still guards
  # budget.example.com; this login gives every person their own Actual user.
  - model: authentik_providers_oauth2.oauth2provider
    id: actual-provider
    state: present
    identifiers:
      name: Provider for Actual Budget
    attrs:
      client_type: confidential
      client_id: !Env AUTHENTIK_ACTUAL_OIDC_CLIENT_ID
      client_secret: !Env AUTHENTIK_ACTUAL_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      grant_types:
        - authorization_code
      include_claims_in_id_token: true
      issuer_mode: per_provider
      sub_mode: hashed_user_id
      redirect_uris:
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://{{ actual_domain }}/openid/callback
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  # Actual Budget application.
  - model: authentik_core.application
    state: present
    identifiers:
      slug: actual-budget
    attrs:
      name: Actual Budget
      provider: !KeyOf actual-provider
      policy_engine_mode: any

  # Allow regular homelab users into Actual Budget (admins inherit membership).
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, actual-budget]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, users]]

  # Grafana OIDC provider.
  - model: authentik_providers_oauth2.oauth2provider
    id: grafana-provider
    state: present
    identifiers:
      name: Provider for Grafana
    attrs:
      client_type: confidential
      client_id: !Env AUTHENTIK_GRAFANA_OIDC_CLIENT_ID
      client_secret: !Env AUTHENTIK_GRAFANA_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      grant_types:
        - authorization_code
      include_claims_in_id_token: true
      issuer_mode: per_provider
      sub_mode: hashed_user_id
      redirect_uris:
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://{{ grafana_domain }}/login/generic_oauth
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  # Grafana application.
  - model: authentik_core.application
    state: present
    identifiers:
      slug: grafana
    attrs:
      name: Grafana
      provider: !KeyOf grafana-provider
      policy_engine_mode: any

  # Restrict Grafana to homelab admins.
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, grafana]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, homelab admins]]

{% if health_coach_oidc_client_id %}
  # Health Coach entries are skipped until health_coach_oidc_client_id is set: an
  # empty client_id would fail validation and abort the whole blueprint import.
  # Health Coach OAuth2 provider for Claude MCP connector.
  - model: authentik_providers_oauth2.oauth2provider
    id: health-coach-provider
    state: present
    identifiers:
      name: Provider for Health Coach
    attrs:
      client_type: confidential
      client_id: !Env AUTHENTIK_HEALTH_COACH_OIDC_CLIENT_ID
      client_secret: !Env AUTHENTIK_HEALTH_COACH_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-explicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      grant_types:
        - authorization_code
        - refresh_token
      include_claims_in_id_token: true
      issuer_mode: per_provider
      sub_mode: user_username
      # Short enough to limit a leaked token, long enough that a missing refresh token
      # (if Claude does not request offline_access) does not log out every few minutes.
      access_token_validity: hours=1
      refresh_token_validity: days=30
      redirect_uris:
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://claude.ai/api/mcp/auth_callback
        - matching_mode: regex
          redirect_uri_type: authorization
          url: '^http://localhost:[0-9]+/callback$'
        - matching_mode: regex
          redirect_uri_type: authorization
          url: '^http://127\.0\.0\.1:[0-9]+/callback$'
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-offline_access]]

  # Health Coach application.
  - model: authentik_core.application
    state: present
    identifiers:
      slug: health-coach
    attrs:
      name: Health Coach
      provider: !KeyOf health-coach-provider
      policy_engine_mode: any

  # Restrict Health Coach to group health coach.
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, health-coach]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, health coach]]

{% endif %}
{% if fit_oidc_client_id and vault_fit_oidc_client_secret | default('') %}
  # Fit MCP connector (openGym training plans), shared by Claude, ChatGPT and Gemini.
  # Every user may connect; the server keys all data by the token's `sub`, so each person
  # only reaches their own openGym account. Skipped until fit_oidc_client_id and
  # vault_fit_oidc_client_secret are set.
  - model: authentik_providers_oauth2.oauth2provider
    id: fit-provider
    state: present
    identifiers:
      name: Provider for Fit
    attrs:
      client_type: confidential
      client_id: !Env AUTHENTIK_FIT_OIDC_CLIENT_ID
      client_secret: !Env AUTHENTIK_FIT_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-explicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      grant_types:
        - authorization_code
        - refresh_token
      include_claims_in_id_token: true
      issuer_mode: per_provider
      # Stable per user even if the username changes; the Fit server stores links by it.
      sub_mode: hashed_user_id
      access_token_validity: hours=1
      refresh_token_validity: days=30
      redirect_uris:
        # Claude (claude.ai, desktop and mobile apps)
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://claude.ai/api/mcp/auth_callback
        # ChatGPT: per-connector callback, plus the legacy fixed one
        - matching_mode: regex
          redirect_uri_type: authorization
          url: '^https://chatgpt\.com/connector/oauth/[A-Za-z0-9_-]+$'
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://chatgpt.com/connector_platform_oauth_redirect
        # Gemini app custom apps: Google's account-linking relay, per-connector path
        - matching_mode: regex
          redirect_uri_type: authorization
          url: '^https://oauth-redirect\.googleusercontent\.com/r/[A-Za-z0-9_.-]+$'
        # Claude Code and other local clients
        - matching_mode: regex
          redirect_uri_type: authorization
          url: '^http://localhost:[0-9]+/callback$'
        - matching_mode: regex
          redirect_uri_type: authorization
          url: '^http://127\.0\.0\.1:[0-9]+/callback$'
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-offline_access]]

  - model: authentik_core.application
    state: present
    identifiers:
      slug: fit
    attrs:
      name: Fit
      provider: !KeyOf fit-provider
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, fit]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, users]]

{% endif %}
{% if vault_nextcloud_oidc_client_secret | default('') %}
  # Nextcloud login (user_oidc app). Nextcloud usernames are the Authentik usernames
  # (preferred_username), so a renamed person gets a new Nextcloud account.
  # Skipped until vault_nextcloud_oidc_client_secret is set.
  - model: authentik_providers_oauth2.oauth2provider
    id: nextcloud-provider
    state: present
    identifiers:
      name: Provider for Nextcloud
    attrs:
      client_type: confidential
      client_id: !Env AUTHENTIK_NEXTCLOUD_OIDC_CLIENT_ID
      client_secret: !Env AUTHENTIK_NEXTCLOUD_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      grant_types:
        - authorization_code
      include_claims_in_id_token: true
      issuer_mode: per_provider
      sub_mode: hashed_user_id
      redirect_uris:
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://{{ nextcloud_domain }}/apps/user_oidc/code
        - matching_mode: strict
          redirect_uri_type: authorization
          url: https://{{ nextcloud_domain }}/index.php/apps/user_oidc/code
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  # The slug is part of the issuer and discovery URL (nextcloud_oidc_slug).
  - model: authentik_core.application
    state: present
    identifiers:
      slug: nextcloud
    attrs:
      name: Nextcloud
      provider: !KeyOf nextcloud-provider
      policy_engine_mode: any

  # Allow regular homelab users into Nextcloud (admins inherit membership).
  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, nextcloud]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, users]]

{% endif %}
  # Domain-level proxy provider for forward auth of user-accessible services.
  - model: authentik_providers_proxy.proxyprovider
    id: homelab-domain-provider
    state: present
    identifiers:
      name: Provider for homelab-domain
    attrs:
      mode: forward_domain
      external_host: https://{{ authentik_domain }}
      cookie_domain: {{ homelab_domain }}
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      access_token_validity: hours=12

  - model: authentik_core.application
    state: present
    identifiers:
      slug: homelab-domain
    attrs:
      name: homelab-domain
      provider: !KeyOf homelab-domain-provider
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, homelab-domain]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, users]]

{% for service in edge_services if (service.access | default('users')) == 'admins' or (service.protected_access | default('')) == 'admins' %}
  # {{ service.name }}: forward auth through the embedded outpost, admins only.
  - model: authentik_providers_proxy.proxyprovider
    id: {{ service.name }}-provider
    state: present
    identifiers:
      name: Provider for {{ service.name }}
    attrs:
      mode: forward_single
      external_host: https://{{ service.domain }}
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      access_token_validity: hours=12

  - model: authentik_core.application
    state: present
    identifiers:
      slug: {{ service.name }}
    attrs:
      name: {{ service.name }}
      provider: !KeyOf {{ service.name }}-provider
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, {{ service.name }}]]
      order: 0
    attrs:
      group: !Find [authentik_core.group, [name, homelab admins]]

{% endfor %}
  # The embedded outpost must serve every proxy provider (domain + admins).
  - model: authentik_outposts.outpost
    state: present
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
        - !KeyOf homelab-domain-provider
{% for service in edge_services if (service.access | default('users')) == 'admins' or (service.protected_access | default('')) == 'admins' %}
        - !KeyOf {{ service.name }}-provider
{% endfor %}

  # Read-only API account for the Authentik widget on the admin Homepage.
  - model: authentik_core.user
    id: homepage-user
    state: present
    identifiers:
      username: homepage
    attrs:
      name: Homepage dashboard
      type: service_account
      path: goauthentik.io/service-accounts
      permissions:
        - authentik_core.view_user
        - authentik_events.view_event

  - model: authentik_core.token
    state: present
    identifiers:
      identifier: homepage-api
    attrs:
      user: !KeyOf homepage-user
      intent: api
      expiring: false
      key: !Env AUTHENTIK_HOMEPAGE_API_TOKEN
      description: Homepage admin dashboard widget

  # Google login source.
  - model: authentik_sources_oauth.oauthsource
    id: google-source
    state: present
    identifiers:
      slug: google
    attrs:
      name: google
      enabled: true
      provider_type: google
      consumer_key: !Env AUTHENTIK_GOOGLE_CLIENT_ID
      consumer_secret: !Env AUTHENTIK_GOOGLE_CLIENT_SECRET
      authentication_flow: !Find [authentik_flows.flow, [slug, default-source-authentication]]
      enrollment_flow: !Find [authentik_flows.flow, [slug, default-source-enrollment]]
      authorization_url: https://accounts.google.com/o/oauth2/v2/auth
      access_token_url: https://oauth2.googleapis.com/token
      profile_url: https://openidconnect.googleapis.com/v1/userinfo
      oidc_jwks_url: https://www.googleapis.com/oauth2/v3/certs
      authorization_code_auth_method: basic_auth
      pkce: S256
      policy_engine_mode: any
      user_matching_mode: identifier
      group_matching_mode: identifier
      user_path_template: goauthentik.io/sources/%(slug)s

  # Show Google on the default authentication page.
  - model: authentik_stages_identification.identificationstage
    state: present
    identifiers:
      name: default-authentication-identification
    attrs:
      sources:
        - !KeyOf google-source
