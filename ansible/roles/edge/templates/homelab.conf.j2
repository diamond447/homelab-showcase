# cloudflared connects to this origin over loopback. Trust only those
# loopback peers when accepting Cloudflare's client IP header.
set_real_ip_from 127.0.0.1;
set_real_ip_from ::1;
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# Behind the tunnel nginx only sees http; relative Location headers keep
# redirects on the client's https URL.
absolute_redirect off;

# No nginx version in error pages and the Server header.
server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Shared proxy limits and timeouts for the HTTP services below.
client_max_body_size 50m;
proxy_connect_timeout 10s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    location / {
        default_type text/plain;
        return 200 "To be developed...\n";
    }
}

{% for service in edge_services %}
server {
    listen 80;
    listen [::]:80;

    server_name {{ service.domain }};
{% if service.max_body_size is defined %}
    client_max_body_size {{ service.max_body_size }};
{% endif %}
{% if service.hsts | default(false) %}
    # Inherited by every location below that sets no add_header of its own.
    add_header Strict-Transport-Security "max-age=15552000" always;
{% endif %}
{% for path in service.deny_paths | default([]) %}

    location ~* {{ path }} {
        return 404;
    }
{% endfor %}
{%- if service.redirect_paths is defined %}
{% for redir in service.redirect_paths %}

    location {{ redir.path }} {
        return 302 {{ redir.target }};
    }
{% endfor %}
{%- endif %}
{%- if service.public_paths is defined %}
{% for public in service.public_paths %}

    # Public path of a forward-auth site: the upstream authenticates on its own.
    location ~ {{ public.pattern }} {
        # No forward auth here: drop identity headers a client might send.
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_set_header X-authentik-email "";
        proxy_set_header X-authentik-name "";
        # The client address as seen by realip (Cloudflare's header, from the tunnel),
        # overwritten so an upstream that trusts it cannot be fed a forged one.
        proxy_set_header CF-Connecting-IP $remote_addr;

        proxy_pass {{ public.upstream | default(service.upstream) }};
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;

        # Public connection is HTTPS at Cloudflare,
        # even though Tunnel -> nginx -> upstream is HTTP.
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% if service.read_timeout is defined %}
        proxy_read_timeout {{ service.read_timeout }};
{% endif %}
{% if not (service.buffering | default(true)) %}
        proxy_buffering off;
{% endif %}
    }
{% endfor %}
{%- endif %}
{%- if service.protected_paths is defined %}

    # Case-insensitive on purpose: the upstream may route paths case-insensitively
    # (Express does), so /Dashboard must not slip past a case-sensitive prefix.
    location ~* ^({{ service.protected_paths | map('regex_escape') | join('|') }}) {
        auth_request /outpost.goauthentik.io/auth/nginx;
        error_page 401 = @goauthentik_proxy_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;

        # Always overwritten from the auth response, so clients cannot spoof them.
        auth_request_set $authentik_username $upstream_http_x_authentik_username;
        proxy_set_header X-authentik-username $authentik_username;
        auth_request_set $authentik_groups $upstream_http_x_authentik_groups;
        proxy_set_header X-authentik-groups $authentik_groups;
        auth_request_set $authentik_email $upstream_http_x_authentik_email;
        proxy_set_header X-authentik-email $authentik_email;
        auth_request_set $authentik_name $upstream_http_x_authentik_name;
        proxy_set_header X-authentik-name $authentik_name;

        proxy_pass {{ service.upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;

        # Public connection is HTTPS at Cloudflare,
        # even though Tunnel -> nginx -> upstream is HTTP.
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% if service.read_timeout is defined %}
        proxy_read_timeout {{ service.read_timeout }};
{% endif %}
{% if not (service.buffering | default(true)) %}
        proxy_buffering off;
{% endif %}
    }
{%- endif %}

    location / {
{% if (service.access | default('users')) != 'none' %}
        auth_request /outpost.goauthentik.io/auth/nginx;
        error_page 401 = @goauthentik_proxy_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;

        # Always overwritten from the auth response, so clients cannot spoof them.
        auth_request_set $authentik_username $upstream_http_x_authentik_username;
        proxy_set_header X-authentik-username $authentik_username;
        auth_request_set $authentik_groups $upstream_http_x_authentik_groups;
        proxy_set_header X-authentik-groups $authentik_groups;
        auth_request_set $authentik_email $upstream_http_x_authentik_email;
        proxy_set_header X-authentik-email $authentik_email;
        auth_request_set $authentik_name $upstream_http_x_authentik_name;
        proxy_set_header X-authentik-name $authentik_name;

{% else %}
        # No forward auth here: drop identity headers a client might send.
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_set_header X-authentik-email "";
        proxy_set_header X-authentik-name "";

{% endif %}
{% if service.strip_authorization | default(false) %}
        # Upstream basic auth is for LAN clients only, never through edge.
        proxy_set_header Authorization "";

{% endif %}
        proxy_pass {{ service.upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;

        # Public connection is HTTPS at Cloudflare,
        # even though Tunnel -> nginx -> upstream is HTTP.
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% if service.read_timeout is defined %}
        proxy_read_timeout {{ service.read_timeout }};
{% endif %}
{% if not (service.buffering | default(true)) %}
        proxy_buffering off;
{% endif %}
    }
{% if (service.access | default('users')) != 'none' or (service.protected_paths | default([])) | length > 0 %}

    location /outpost.goauthentik.io {
        proxy_pass http://{{ authentik_host }}:{{ authentik_port }}/outpost.goauthentik.io;
        # The outpost picks the provider from X-Forwarded-Host (else Host). Pin both,
        # and the URL, to this server's own domain: a client-sent X-Forwarded-Host (or
        # an absolute request URI naming another site) would otherwise let a session
        # of the users-wide domain provider pass the auth check of an admins-only site.
        proxy_set_header Host {{ service.domain }};
        proxy_set_header X-Forwarded-Host {{ service.domain }};
        proxy_set_header X-Original-URL https://{{ service.domain }}$request_uri;
        add_header Set-Cookie $auth_cookie always;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    location @goauthentik_proxy_signin {
        internal;
        add_header Set-Cookie $auth_cookie always;
        return 302 /outpost.goauthentik.io/start?rd=https://{{ service.domain }}$request_uri;
    }
{% endif %}
}
{% endfor %}
