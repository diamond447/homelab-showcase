# Managed by Ansible (role nextcloud). Read by the app and cron containers; the
# image's config/*.config.php files read most of these at runtime as well.
POSTGRES_HOST=db
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD={{ vault_nextcloud_postgres_password }}
REDIS_HOST=redis

# Used only by the automatic installation on the first start.
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user }}
NEXTCLOUD_ADMIN_PASSWORD={{ vault_nextcloud_admin_password }}
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_domain }}

# Behind edge01 (Cloudflare Tunnel -> NGINX), which sets X-Forwarded-*.
TRUSTED_PROXIES={{ edge01_host }}
APACHE_DISABLE_REWRITE_IP=1
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://{{ nextcloud_domain }}

PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G
