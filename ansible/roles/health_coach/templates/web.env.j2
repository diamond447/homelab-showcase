# Managed by Ansible (role health_coach). Internet-facing healthstats PWA: reads with the
# read-only role; its only write, journal entries, uses web_journal, which can touch
# nothing but journal_entries. Edge forward auth (admins) sets X-authentik-username; the
# app rejects /api/ requests from any other user.
HC_RO_DATABASE_URL=postgresql+psycopg://coach_ro:{{ vault_health_coach_ro_password }}@db:5432/health
HC_WEB_JOURNAL_DATABASE_URL=postgresql+psycopg://web_journal:{{ vault_health_coach_web_journal_password }}@db:5432/health
HC_TIMEZONE={{ timezone }}
HC_WEB_HOST=0.0.0.0
HC_WEB_PORT=8090
HC_WEB_ALLOWED_USERS={{ health_coach_allowed_users | to_json }}
HC_WEB_USER_HEADER=X-authentik-username
# Deliberately absurd placeholders, so a missing profile is easy to spot (age 126,
# max HR 111). The real values live in the health database: the coach stores them with
# set_profile, and they override these.
HC_HR_MAX=111
HC_BIRTH_YEAR=1900
