#!/bin/sh
# Restricts LAN access to the Docker-published ports on health01.
# Managed by Ansible (role health_coach). Replaces its own chain atomically
# on every run, so removed ports or sources do not leave stale rules behind.
set -eu

CHAIN="{{ health_coach_firewall_chain }}"

# Declaring the chain in --noflush mode replaces its rules in one transaction.
iptables-restore -w --noflush <<RULES
*filter
:$CHAIN - [0:0]
# Containers of other compose projects on this host (the internet-facing Fit stack) must
# not reach the health database, the coach MCP or the healthstats app through the
# published host ports. The health containers talk to each other on their own network
# and are not affected.
-A $CHAIN ! -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdst {{ health_coach_host }} --ctorigdstport {{ health_coach_db_port }} -j DROP
-A $CHAIN ! -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdst {{ health_coach_host }} --ctorigdstport {{ health_coach_mcp_port }} -j DROP
-A $CHAIN ! -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdst {{ health_coach_host }} --ctorigdstport {{ health_coach_web_port }} -j DROP
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ edge01_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_mcp_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ monitor_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_mcp_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_mcp_port }} -j DROP
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ edge01_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_web_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ monitor_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_web_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_web_port }} -j DROP
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ edge01_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ fit_web_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ monitor_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ fit_web_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport {{ fit_web_port }} -j DROP
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ edge01_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ fit_mcp_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ monitor_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ fit_mcp_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport {{ fit_mcp_port }} -j DROP
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -s {{ monitor_host }} -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_db_port }} -j RETURN
-A $CHAIN -i {{ health_coach_firewall_interface }} -p tcp -m conntrack --ctdir ORIGINAL --ctorigdstport {{ health_coach_db_port }} -j DROP
COMMIT
RULES

# Docker creates DOCKER-USER and jumps to it from FORWARD for published ports.
iptables -w -N DOCKER-USER 2>/dev/null || true
iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null || iptables -w -I DOCKER-USER -j "$CHAIN"
