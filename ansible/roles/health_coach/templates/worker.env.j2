# Managed by Ansible (role health_coach). Ingest worker.
HC_INGEST_DATABASE_URL=postgresql+psycopg://ingest:{{ vault_health_coach_ingest_password }}@db:5432/health
HC_TIMEZONE={{ timezone }}
HC_TOKEN_KEY={{ vault_health_coach_token_key }}
HC_GOOGLE_CLIENT_ID={{ health_coach_google_client_id }}
HC_GOOGLE_CLIENT_SECRET={{ vault_health_coach_google_client_secret | default('') }}
# openGym API of the owner's account (token stored by `health-coach auth opengym`).
HC_OPENGYM_URL=http://{{ health_coach_host }}:{{ fit_web_port }}
HC_OPENGYM_VERSION={{ fit_opengym_version }}
HC_NTFY_URL={{ ntfy_server }}
HC_NTFY_TOPIC={{ vault_health_ntfy_topic }}
HC_NTFY_TOKEN={{ vault_ntfy_health_token }}
HC_NOTIFY_LANG=cs
# Deliberately absurd placeholders, so a missing profile is easy to spot (age 126,
# max HR 111). The real values live in the health database: the coach stores them with
# set_profile, and they override these.
HC_HR_MAX=111
HC_BIRTH_YEAR=1900
