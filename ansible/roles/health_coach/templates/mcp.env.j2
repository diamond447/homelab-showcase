# Managed by Ansible (role health_coach). Internet-facing MCP server: no superuser
# password, no token key, no Google secret.
HC_RO_DATABASE_URL=postgresql+psycopg://coach_ro:{{ vault_health_coach_ro_password }}@db:5432/health
HC_RW_DATABASE_URL=postgresql+psycopg://coach_rw:{{ vault_health_coach_rw_password }}@db:5432/health
HC_TIMEZONE={{ timezone }}
HC_MCP_HOST=0.0.0.0
HC_MCP_PORT=8080
HC_MCP_ALLOWED_HOSTS=["{{ health_coach_domain }}","{{ health_coach_host }}:{{ health_coach_mcp_port }}"]
HC_PUBLIC_URL=https://{{ health_coach_domain }}/mcp
HC_AUTH_ISSUER=https://{{ authentik_domain }}/application/o/health-coach/
HC_AUTH_AUDIENCE={{ health_coach_oidc_client_id }}
HC_AUTH_JWKS_URL=http://{{ authentik_host }}:{{ authentik_port }}/application/o/health-coach/jwks/
HC_AUTH_ALLOWED_SUBJECTS={{ health_coach_allowed_users | to_json }}
HC_NTFY_URL={{ ntfy_server }}
HC_NTFY_TOPIC={{ vault_health_ntfy_topic }}
HC_NTFY_TOKEN={{ vault_ntfy_health_token }}
